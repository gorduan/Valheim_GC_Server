<Project>
  <!--
    Mod-Steckbrief (Gorduan-SDK). Eine Mod trägt in ihrer .csproj ein:
      GcId          kurze ID, z. B. tiere            → GUID gorduan.gc.tiere
      GcPaket       GC_Server | GC_Client | ValheimPlusPlus: Paket, in dessen Ordner die DLL kommt (siehe GcPackage unten)
      GcStufe       1 Sehr Vanilla … 5 GC
      GcSeite       Spieler | ServerOptional | Alle
                    Spieler: läuft nur beim Spieler (Jötunn prüft nichts)
                    ServerOptional: hat der Server die Mod, brauchen alle sie; ohne Server bleiben die Server-Teile aus
                    Alle: Server und alle Spieler brauchen genau diese Mod
      GcBraucht     IDs anderer GC-Mods, ohne die sie nicht startet (harte Abhängigkeit), mit ; getrennt
      GcPartner     IDs anderer GC-Mods, mit denen sie mehr kann (weiche Abhängigkeit, lädt danach)
      GcFremd       GUIDs fremder Mods, mit denen sie mehr kann (z. B. randyknapp.mods.epicloot)
      GcAlteConfig  cfg-Datei(en) des alten Sammelpakets, mit ; getrennt; Werte daraus übernimmt der erste Start
      GcAusgleich   Schwierigkeitsausgleich in % je besiegtem Boss, solange die Mod läuft (der Boss-Fortschritt nimmt den höchsten)
      GcTitel, GcBeschreibung  für README und Katalog
    Daraus entsteht obj\GcModInfo.g.cs: die Plugin-Attribute an der Klasse Plugin (partial) und die Klasse GcMod, samt der
    Liste ihrer Patch-Klassen (GcMod.PatchTypes, GcMod.PatchAll; Liste auch in obj\GcPatchTypes.txt für die Prüfung in
    build.ps1). Seit 26.10.2026 liegen die Mods eines Pakets zusammen in einer DLL (Gorduan: Thunderstore); harmony.PatchAll(Assembly)
    spielte dort die Patches aller Mods ein, mehrfach und auch für ausgeschaltete Mods.
  -->

  <ItemGroup Condition="'$(GcId)' != ''">
    <ProjectReference Include="$(GcModsRoot)Kern\GC_Kern.csproj" Private="false" />
  </ItemGroup>

  <UsingTask TaskName="GcWriteModInfo" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <OutputFile ParameterType="System.String" Required="true" />
      <RootNamespace ParameterType="System.String" Required="true" />
      <ModId ParameterType="System.String" Required="true" />
      <ModName ParameterType="System.String" Required="true" />
      <ModVersion ParameterType="System.String" Required="true" />
      <Stufe ParameterType="System.String" Required="true" />
      <Seite ParameterType="System.String" Required="true" />
      <Braucht ParameterType="System.String" />
      <Partner ParameterType="System.String" />
      <Fremd ParameterType="System.String" />
      <AlteConfig ParameterType="System.String" />
      <Ausgleich ParameterType="System.String" />
      <SourceFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" />
      <PatchListFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Func<string, string[]> split = s => (s ?? "").Split(new[] { ';', ',' }, StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim()).Where(x => x.Length > 0).ToArray();
        string[] needs = split(Braucht);
        string[] partners = split(Partner);
        string[] foreign = split(Fremd);
        string seite = Seite.Trim();
        string level;
        switch (seite)
        {
          case "Spieler": level = "NotEnforced"; break;
          case "ServerOptional": level = "ClientMustHaveMod"; break;
          case "Alle": level = "EveryoneMustHaveMod"; break;
          default: Log.LogError("GcSeite muss Spieler, ServerOptional oder Alle sein, nicht '" + seite + "'."); return false;
        }
        Func<string[], string> list = a => a.Length == 0 ? "System.Array.Empty<string>()" : "new[] { " + string.Join(", ", a.Select(x => "\"" + x + "\"")) + " }";
        // Patch-Klassen: [HarmonyPatch] ohne Einrückung (Klassen-Attribut; alle Klassen stehen in Dateien mit einem
        // Namespace der Form „namespace X;“), die nächste Klassendeklaration darunter. build.ps1 prüft die Liste gegen die DLL.
        List<string> patchTypes = new List<string>();
        foreach (Microsoft.Build.Framework.ITaskItem item in SourceFiles ?? new Microsoft.Build.Framework.ITaskItem[0])
        {
          string path = item.GetMetadata("FullPath");
          if (!File.Exists(path) || path.EndsWith(".g.cs", StringComparison.OrdinalIgnoreCase))
          {
            continue;
          }
          string[] lines = File.ReadAllLines(path);
          string ns = lines.Select(l => Regex.Match(l, @"^\s*namespace\s+([\w.]+)\s*;")).Where(m => m.Success).Select(m => m.Groups[1].Value).FirstOrDefault();
          for (int i = 0; i < lines.Length; i++)
          {
            if (!lines[i].StartsWith("[HarmonyPatch", StringComparison.Ordinal))
            {
              continue;
            }
            for (int j = i; j < Math.Min(i + 12, lines.Length); j++)
            {
              Match c = Regex.Match(lines[j], @"^(?:\[.*\]\s*)*(?:(?:internal|public|private|static|sealed|partial|file)\s+)*class\s+(\w+)");
              if (c.Success)
              {
                string full = (ns == null ? "" : ns + ".") + c.Groups[1].Value;
                if (!patchTypes.Contains(full))
                {
                  patchTypes.Add(full);
                }
                break;
              }
            }
          }
        }
        patchTypes.Sort(StringComparer.Ordinal);
        StringBuilder sb = new StringBuilder();
        sb.AppendLine("// <auto-generated> Aus den Gc*-Eigenschaften der .csproj (Directory.Build.targets). Nicht von Hand ändern. </auto-generated>");
        sb.AppendLine("using BepInEx;");
        sb.AppendLine("using Jotunn.Utils;");
        sb.AppendLine();
        sb.AppendLine("namespace " + RootNamespace + ";");
        sb.AppendLine();
        sb.AppendLine("[BepInPlugin(GcMod.Guid, GcMod.Name, GcMod.Version)]");
        sb.AppendLine("[BepInDependency(Jotunn.Main.ModGuid)]");
        sb.AppendLine("[BepInDependency(GC.Shared.GcKern.Guid)]");
        foreach (string id in needs) sb.AppendLine("[BepInDependency(\"gorduan.gc." + id + "\")]");
        foreach (string id in partners) sb.AppendLine("[BepInDependency(\"gorduan.gc." + id + "\", BepInDependency.DependencyFlags.SoftDependency)]");
        foreach (string guid in foreign) sb.AppendLine("[BepInDependency(\"" + guid + "\", BepInDependency.DependencyFlags.SoftDependency)]");
        sb.AppendLine("[NetworkCompatibility(CompatibilityLevel." + level + ", VersionStrictness.Minor)]");
        sb.AppendLine("public partial class Plugin");
        sb.AppendLine("{");
        sb.AppendLine("}");
        sb.AppendLine();
        sb.AppendLine("/// <summary>Steckbrief dieser Mod (aus der .csproj).</summary>");
        sb.AppendLine("internal static class GcMod");
        sb.AppendLine("{");
        sb.AppendLine("\tpublic const string Id = \"" + ModId + "\";");
        sb.AppendLine("\tpublic const string Guid = \"gorduan.gc." + ModId + "\";");
        sb.AppendLine("\tpublic const string Name = \"" + ModName + "\";");
        sb.AppendLine("\tpublic const string Version = \"" + ModVersion + "\";");
        sb.AppendLine("\tpublic const int Stufe = " + int.Parse(Stufe) + ";");
        sb.AppendLine();
        sb.AppendLine("\tpublic static GC.Shared.GcModInfo Info => new()");
        sb.AppendLine("\t{");
        sb.AppendLine("\t\tId = Id,");
        sb.AppendLine("\t\tGuid = Guid,");
        sb.AppendLine("\t\tName = Name,");
        sb.AppendLine("\t\tVersion = Version,");
        sb.AppendLine("\t\tStufe = Stufe,");
        sb.AppendLine("\t\tSeite = GC.Shared.GcSeite." + seite + ",");
        sb.AppendLine("\t\tBraucht = " + list(needs) + ",");
        sb.AppendLine("\t\tPartner = " + list(partners) + ",");
        sb.AppendLine("\t\tFremd = " + list(foreign) + ",");
        sb.AppendLine("\t\tAlteConfig = \"" + (AlteConfig ?? "").Trim() + "\",");
        string ausgleich = string.IsNullOrWhiteSpace(Ausgleich) ? "0" : Ausgleich.Trim().Replace(',', '.');
        sb.AppendLine("\t\tAusgleich = " + ausgleich + "f,");
        sb.AppendLine("\t};");
        sb.AppendLine();
        sb.AppendLine("\t/// <summary>Patch-Klassen dieser Mod (aus ihren Quelldateien). Die Mods eines Pakets liegen in einer DLL.</summary>");
        sb.AppendLine("\tpublic static readonly System.Type[] PatchTypes =");
        sb.AppendLine("\t{");
        foreach (string type in patchTypes) sb.AppendLine("\t\ttypeof(global::" + type + "),");
        sb.AppendLine("\t};");
        sb.AppendLine();
        sb.AppendLine("\t/// <summary>Spielt nur die Patches dieser Mod ein (statt harmony.PatchAll(Assembly), das alle Mods der DLL träfe).</summary>");
        sb.AppendLine("\tpublic static void PatchAll(HarmonyLib.Harmony harmony)");
        sb.AppendLine("\t{");
        sb.AppendLine("\t\tforeach (System.Type type in PatchTypes)");
        sb.AppendLine("\t\t{");
        sb.AppendLine("\t\t\tharmony.CreateClassProcessor(type).Patch();");
        sb.AppendLine("\t\t}");
        sb.AppendLine("\t}");
        sb.AppendLine("}");
        string text = sb.ToString();
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != text)
        {
          File.WriteAllText(OutputFile, text, new UTF8Encoding(false));
        }
        string listText = string.Join("\n", patchTypes) + (patchTypes.Count > 0 ? "\n" : "");
        if (!File.Exists(PatchListFile) || File.ReadAllText(PatchListFile) != listText)
        {
          File.WriteAllText(PatchListFile, listText, new UTF8Encoding(false));
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GcGenerateModInfo" BeforeTargets="CoreCompile" Condition="'$(GcId)' != ''">
    <PropertyGroup>
      <_GcInfoFile>$(IntermediateOutputPath)GcModInfo.g.cs</_GcInfoFile>
    </PropertyGroup>
    <GcWriteModInfo OutputFile="$(_GcInfoFile)" RootNamespace="$(RootNamespace)" ModId="$(GcId)" ModName="$(AssemblyName)" ModVersion="$(Version)"
                    Stufe="$(GcStufe)" Seite="$(GcSeite)" Braucht="$(GcBraucht)" Partner="$(GcPartner)" Fremd="$(GcFremd)" AlteConfig="$(GcAlteConfig)" Ausgleich="$(GcAusgleich)"
                    SourceFiles="@(Compile)" PatchListFile="$(IntermediateOutputPath)GcPatchTypes.txt" />
    <ItemGroup>
      <Compile Include="$(_GcInfoFile)" />
      <FileWrites Include="$(_GcInfoFile)" />
    </ItemGroup>
  </Target>

  <!--
    Paket: Kern und Vorlader kommen als eigene DLL nach build-output\GCMods\Gorduan-<GcPaket>\ (GcPaket kann mehrere Pakete
    nennen, der Kern liegt in jedem; GcOrdner legt die DLL in einen Unterordner, patchers: der Vorlader GC_ModSchalter,
    r2modman legt ihn nach BepInEx\patchers). Die Mods (GcId) kopiert dieses Ziel nicht mehr: Seit 26.10.2026 führt je
    Paket ein Projekt unter Pakete\ sie zu einer DLL zusammen (Gorduan: „setze die drei Mods wieder zusammen“, wegen
    Thunderstore; jede Mod bleibt ein eigenes Plugin mit eigener GUID und cfg). manifest.json, README.md und icon.png
    schreibt build.ps1.
  -->
  <!-- Ohne Spiel-DLLs bricht der Bau mit einer klaren Meldung ab statt mit hunderten fehlenden Typen (englisch: öffentliche Repos). -->
  <Target Name="GcCheckGame" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(Managed)\assembly_valheim.dll') Or !Exists('$(JotunnDll)')">
    <Error Text="Valheim or Jotunn not found (GamePath: $(GamePath), JotunnDll: $(JotunnDll)). Copy GamePaths.user.props.example to GamePaths.user.props and set both paths." />
  </Target>

  <Target Name="GcPackage" AfterTargets="Build" Condition="'$(GcId)' == '' And '$(GcPaketZiel)' == ''">
    <ItemGroup>
      <_GcPakete Include="$(GcPaket)" Condition="'$(GcPaket)' != ''" />
      <_GcPakete Include="$(AssemblyName)" Condition="'$(GcPaket)' == ''" />
    </ItemGroup>
    <MakeDir Directories="@(_GcPakete->'$(GcPackageOut)\Gorduan-%(Identity)\$(GcOrdner)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GcPackageOut)\Gorduan-%(_GcPakete.Identity)\$(GcOrdner)" />
  </Target>
</Project>
