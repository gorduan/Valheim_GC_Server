<Project Sdk="Microsoft.NET.Sdk">
  <!--
    GC_Kern (Gorduan): Laufzeit des GC-SDK. Jede GC-Mod braucht ihn: gemeinsames Menü „GC Option“, Einstellungen mit
    Übernahme aus den alten Sammelpaketen, Texte, Rechte, Stufe des Servers, Mod-Abgleich, Hilfen für andere Mods.
    Gemeinsame Einstellungen: ..\Directory.Build.props
  -->
  <PropertyGroup>
    <AssemblyName>GC_Kern</AssemblyName>
    <RootNamespace>GC.Shared</RootNamespace>
    <Product>GC_Kern</Product>
    <Version>1.2.0</Version>
    <GcPaket>GC_Server;GC_Client;ValheimPlusPlus</GcPaket>
  </PropertyGroup>
  <ItemGroup>
    <!-- Mod-Liste: manifest.json der Pakete lesen (JsonUtility); keine Web-Anfragen mehr (Update-Prüfung entfernt, 25.10.2026) -->
    <Reference Include="UnityEngine.JSONSerializeModule" HintPath="$(Managed)\UnityEngine.JSONSerializeModule.dll" Private="false" />
    <!-- DeepTip (gorduan.deeptip): feste Abhängigkeit seit 1.9.0 (Gorduan, 30.10.2026), Erklärfenster für alle GC-Mods -->
    <Reference Include="GC_Valheim_DeepTip" HintPath="$(DeepTipDll)" Private="false" />
  </ItemGroup>
</Project>
